# 智能数据分析平台 v2 - 环境变量示例
# 复制此文件为 .env 并根据本机 / Docker 环境调整

# ============================================
# 应用配置
# ============================================
APP_NAME=智能数据分析平台
APP_VERSION=2.0.0
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# 安全
# ============================================
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# 数据库
# 本地开发可改回 SQLite:
# DATABASE_URL=sqlite:///./data_platform.db
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/data_platform

# ============================================
# Redis / Celery
# ============================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# MinIO
# ============================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123456
MINIO_BUCKET_NAME=data-platform

# ============================================
# 爬虫与采集
# ============================================
CRAWL_MAX_CONCURRENT=100
CRAWL_DEFAULT_DELAY=1.0
CRAWL_MAX_RETRIES=3
CRAWL_TIMEOUT=30
JUSTONE_API_TOKEN=

# ============================================
# ML
# ============================================
ML_DEFAULT_TEST_SIZE=0.2
ML_DEFAULT_RANDOM_STATE=42
ML_MODEL_DIR=./data/models

# ============================================
# MCP 工具面（供 Hermes 等外部代理调用）
# ============================================
# 格式：token:principal，多个用逗号分隔
#   MCP_API_KEY=tokenA:hermes,tokenB:localagent
# 单客户端可省略 principal：MCP_API_KEY=tokenA
#
# 安全约定：未配置时所有需鉴权的工具调用一律被拒绝（fail-closed），
# 而不是静默放行。生成 token 建议：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_API_KEY=

# 合规判定的授权令牌有效期（小时）
COMPLIANCE_TOKEN_TTL_HOURS=72

